# frozen_string_literal: true

# Generated by forge <%= plan.meta[:forge_version] %> for <%= class_name %>. Fixtures: fixtures.json (same directory).
require_relative 'generated_spec_helper'
require_relative '<%= plan.provider[:file_name].delete_suffix('.rb') %>'

RSpec.describe Provider::<%= class_name %> do
  subject(:service) { described_class.new(provider: build_record('<%= plan.provider[:name] %>'), operations: operations) }

  let(:operations) { Provider::MemoryOperations.new }
  let(:operation) { build_operation.tap { |op| operations.save(op) } }
  let(:create_fixture) { fixtures['create_request'] }
  let(:provider_id) { dig_path(create_fixture['<%= create_response_key %>'], <%= provider_id_path %>) }
  let(:create_url) { "#{described_class::BASE_URL}<%= op(:create).path %><%= query_suffix %>" }
<% unless overridden_paths.empty? -%>
  let(:overridden) { <%= overridden_paths.inspect %> } # source задан в overrides.yml — не сравнивается
<% end -%>
<% if auth_header_expectation -%>
  let(:auth_headers) { { <%= auth_header_expectation %> } }
<% else -%>
  let(:auth_headers) { { 'Accept' => 'application/json' } } # auth без заголовков (apiKey в query / none)
<% end -%>

  describe '#check_conditions' do
<% if min? -%>
    it 'rejects amount below minimum' do
      operation.amount = described_class::MIN_AMOUNT - 0.01
      expect(service.check_conditions(operation, 'create').code).to eq('amount_too_low')
    end

<% end -%>
    it 'accepts the fixture operation' do
      expect(service.check_conditions(operation, 'create')).to be_success
    end
  end

  describe '#create_request' do
    it 'creates payout (<%= create_response_status %>)' do
<% if synthesized_request? -%>
      # Пример запроса в спеке отсутствует — фикстура синтезирована по схеме; сверяем только ключи верхнего уровня.
      stub = stub_request(:post, create_url).with(headers: auth_headers) { |req| (parse_body(req).keys - create_fixture['request'].keys).empty? }
<% elsif overridden_paths.empty? -%>
      stub = stub_request(:post, create_url).with(headers: auth_headers) { |req| subset_of?(parse_body(req), create_fixture['request']) }
<% else -%>
      expected_body = without_paths(create_fixture['request'], overridden)
      stub = stub_request(:post, create_url).with(headers: auth_headers) { |req| subset_of?(without_paths(parse_body(req), overridden), expected_body) }
<% end -%>
                                            .to_return(status: <%= create_response_status %>, body: create_fixture['<%= create_response_key %>'].to_json,
                                                       headers: { 'Content-Type' => 'application/json' })
      result = service.create_request(operation, 'create')
      expect(result).to be_success
      expect(stub).to have_been_requested
      expect(operations.find(operation.id).provider_operation_key).to eq(provider_id)
      expect(result.data.dig(:result, :id)).to eq(provider_id) # платформа: provider_operation_key = payload.dig(:result, :id)
      expect(result.data[:status]).to eq(create_fixture['expected_operation_status'])
    end

<% if error_code(422) -%>
    it 'maps 422 to <%= error_code(422) %>' do
      stub_request(:post, create_url).to_return(status: 422, body: (create_fixture['response_422'] || {}).to_json,
                                                headers: { 'Content-Type' => 'application/json' })
      expect(service.create_request(operation, 'create').code).to eq('<%= error_code(422) %>')
    end

<% end -%>
<% if plan.requisite_types.any? -%>
    it 'refuses an operation without a known requisite type' do
      operation.payout_requisite = { 'unknown_type' => {} }
      expect(service.create_request(operation, 'create').code).to eq('requisite_missing')
    end

<% end -%>
<% if plan.requisite_types.include?('card') -%>
    it 'accepts the flat card form of payout_requisite' do
      operation.payout_requisite = <%= flat_card %>
      stub = stub_request(:post, create_url).to_return(status: <%= create_response_status %>, body: create_fixture['<%= create_response_key %>'].to_json,
                                                     headers: { 'Content-Type' => 'application/json' })
      expect(service.create_request(operation, 'create')).to be_success
      expect(stub).to have_been_requested
    end

<% end -%>
    it 'maps 401 to invalid_credentials' do
      stub_request(:post, create_url).to_return(status: 401, body: '{}')
      expect(service.create_request(operation, 'create').code).to eq('provider.invalid_credentials')
    end

    it 'maps 429 to rate_limit with retry_after' do
      stub_request(:post, create_url).to_return(status: 429, body: '{}', headers: { 'Retry-After' => '60' })
      result = service.create_request(operation, 'create')
      expect(result.code).to eq('provider.rate_limit')
      expect(result.data[:retry_after]).to eq(60)
    end

    it 'maps 5xx to provider.unavailable' do
      stub_request(:post, create_url).to_return(status: 503, body: '{}')
      expect(service.create_request(operation, 'create').code).to eq('provider.unavailable')
    end
<% if op(:status) && status_response_key -%>

    it 'delegates status request_method to fetch_status' do
      operation.provider_operation_key = provider_id
      stub = stub_request(:<%= status_verb %>, <%= url(:status) %>)
             .to_return(status: <%= op(:status).success_statuses.first %>, body: fixtures.dig('fetch_status', '<%= status_response_key %>').to_json,
                        headers: { 'Content-Type' => 'application/json' })
      service.create_request(operation, 'status')
      expect(stub).to have_been_requested
    end
<% end -%>
  end

<% if op(:status) && status_response_key -%>
  describe '#fetch_status' do
    it 'maps the provider status to <%= fx.dig('fetch_status', 'expected_operation_status') || 'an internal status' %>' do
      operation.provider_operation_key = provider_id
      stub_request(:<%= status_verb %>, <%= url(:status) %>)
        .to_return(status: <%= op(:status).success_statuses.first %>, body: fixtures.dig('fetch_status', '<%= status_response_key %>').to_json,
                   headers: { 'Content-Type' => 'application/json' })
      result = service.fetch_status(operation)
<% if fx.dig('fetch_status', 'expected_operation_status') -%>
      expect(result).to be_success
      expect(result.data[:status]).to eq('<%= fx.dig('fetch_status', 'expected_operation_status') %>')
<% else -%>
      # Статус в ответе спекой не описан (нет enum/примера): сервис либо применяет его, либо честно сообщает unknown.
      expect(result.success? || result.code == 'unknown_provider_status').to be(true)
<% end -%>
    end
  end
<% else -%>
  describe '#fetch_status' do
    it 'is not available in the spec' do
      expect(service.fetch_status(operation).code).to eq('status_endpoint_missing')
    end
  end
<% end -%>

  describe '#process_callback' do
<% if plan.webhook.nil? -%>
    it 'returns callbacks_not_supported' do
      expect(service.process_callback({}).code).to eq('callbacks_not_supported')
    end
<% elsif timestamp_unsupported? -%>
    it 'needs a hand-written signature check' do
      pending 'signature with timestamp is not generated (see report.txt)'
      raise 'implement verify_signature! first'
    end
<% else -%>
    let(:callback) { fixtures['callback'] }
    let(:body) { JSON.generate(callback['payload']) }
<% if signature? -%>
    let(:headers) { { '<%= signature[:header] %>' => <%= sign_expr('body') %> } }
<% else -%>
    let(:headers) { {} }
<% end -%>

    before do
      operation.provider_operation_key = dig_path(callback['payload'], <%= callback_id_path %>)
      operations.save(operation)
    end

<% if fx['callback'] -%>
    it 'approves on <%= event_of('callback') || 'success' %> with valid signature' do
      result = service.process_callback(callback['payload'], raw_body: body, headers: headers)
      expect(result).to be_success
      expect(result.data[:status]).to eq('<%= fx.dig('callback', 'expected_operation_status') %>')
    end

<% end -%>
<% if fx['callback_failed'] -%>
    it 'rejects on <%= event_of('callback_failed') || 'failure' %>' do
      failed = fixtures['callback_failed']['payload']
      failed_body = JSON.generate(failed)
<% if signature? -%>
      failed_headers = { '<%= signature[:header] %>' => <%= sign_expr('failed_body') %> }
<% else -%>
      failed_headers = {}
<% end -%>
      operation.provider_operation_key = dig_path(failed, <%= callback_id_path %>)
      result = service.process_callback(failed, raw_body: failed_body, headers: failed_headers)
      expect(result.data[:status]).to eq('rejected')
<% if callback_error_code -%>
      expect(result.data[:error_code]).to eq('<%= callback_error_code %>')
<% end -%>
    end

<% end -%>
<% if signature? -%>
    it 'fails on invalid signature' do
      result = service.process_callback(callback['payload'], raw_body: body, headers: { '<%= signature[:header] %>' => 'bad' })
      expect(result.code).to eq('invalid_signature')
    end
<% end -%>
<% end -%>
  end
<% if op(:cancel) && cancel_expected -%>

  describe '<%= class_name.delete_suffix('Service') %>Extras#cancel_request' do
    it 'cancels a pending payout' do
      require_relative '<%= plan.provider[:name] %>_extras'
      extras = Provider::<%= class_name.delete_suffix('Service') %>Extras.new(provider: build_record('<%= plan.provider[:name] %>'), operations: operations)
      operation.provider_operation_key = provider_id
      stub_request(:<%= op(:cancel).method == 'delete' ? 'delete' : 'post' %>, <%= url(:cancel) %>)
        .to_return(status: <%= op(:cancel).success_statuses.first %>, body: fixtures.dig('cancel', 'response_<%= op(:cancel).success_statuses.first %>').to_json,
                   headers: { 'Content-Type' => 'application/json' })
      expect(extras.cancel_request(operation).data[:status]).to eq('<%= cancel_expected %>')
    end
  end
<% end -%>
end
