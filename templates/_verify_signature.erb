<% if view.timestamp_unsupported? -%>
    # TODO(forge): <%= view.signature[:header] %> includes a timestamp/nonce; implement per provider docs.
    def verify_signature!(_raw_body, _headers)
      raise NotImplementedError, 'signature scheme with timestamp is not generated (see report.txt)'
    end
<% else -%>
    # <%= view.signature_comment %>
    def verify_signature!(raw_body, headers)
      given = header_value(headers, SIGNATURE_HEADER)
      expected = <%= view.hmac_expr %>
      raise Provider::SignatureError, "invalid #{SIGNATURE_HEADER}" unless secure_compare(given, expected)
    end
<% end -%>
