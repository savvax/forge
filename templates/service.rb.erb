# frozen_string_literal: true

# Generated by forge <%= plan.meta[:forge_version] %> from <%= plan.meta[:spec_title] %> <%= plan.meta[:spec_version] %> (<%= File.basename(plan.meta[:spec_file]) %>).
# Do not edit by hand: regenerate with `bin/forge generate`; adjust decisions in overrides.yml.

<% view.requires.each do |lib| -%>
require '<%= lib %>'
<% end -%>

module Provider
  class <%= plan.provider[:class_name] %> < BaseService
    BASE_URL = ENV.fetch('<%= plan.base_url[:env_var] %>', '<%= plan.base_url[:default] %>')
<% if plan.base_url[:production] && plan.base_url[:production] != plan.base_url[:default] -%>
    PRODUCTION_URL = '<%= plan.base_url[:production] %>'
<% end -%>

<% if plan.status_map.empty? -%>
    STATUS_MAP = {}.freeze # TODO(forge): no status enum in the spec; fill from the provider docs (statuses.<X>: … in overrides.yml)
<% else -%>
    STATUS_MAP = {
<%= view.aligned(plan.status_map).map { |l| "      #{l}" }.join(",\n") %>
    }.freeze
<% end -%>
<% if view.webhook && !plan.event_map.empty? -%>

    EVENT_MAP = {
<%= view.aligned(plan.event_map).map { |l| "      #{l}" }.join(",\n") %>
    }.freeze
<% end -%>

    ERROR_MAP = {
<%= view.error_map_lines.map { |l| "      #{l}" }.join(",\n") %>
    }.freeze

    SUCCESS_STATUSES = <%= plan.success_statuses.inspect %>.freeze<%= view.success_comment %>
<% if view.requisites? -%>
    REQUISITE_TYPES = %w[<%= plan.requisite_types.join(' ') %>].freeze
<% if view.type_values? -%>
    REQUISITE_TYPE_VALUES = <%= view.type_values.inspect %>.freeze # canonical type → value the provider expects
<% end -%>
<% end -%>
    STATUS_METHODS = %w[status check].freeze
<% unless plan.amount[:currencies].empty? -%>
    SUPPORTED_CURRENCIES = %w[<%= plan.amount[:currencies].join(' ') %>].freeze
<% end -%>
<% if view.minor? -%>
    AMOUNT_MULTIPLIER = <%= plan.amount[:multiplier] %> # <%= view.minor_comment %>
<% end -%>
<% if plan.amount[:minimum_major] -%>
    MIN_AMOUNT = <%= plan.amount[:minimum_major] %> # <%= view.min_comment %>
<% end -%>
<% if plan.amount[:maximum_major] -%>
    MAX_AMOUNT = <%= plan.amount[:maximum_major] %>
<% end -%>
<% if view.signature? -%>
    SIGNATURE_HEADER = '<%= view.signature[:header] %>'
<% end -%>

    def check_conditions(operation, request_method)
      base_result = super
      return base_result if base_result.failed?
<% view.validations.each do |line| -%>
      <%= line %>
<% end -%>
<% view.pattern_checks.each do |lines| -%>

<% lines.each do |line| -%>
      <%= line %>
<% end -%>
<% end -%>

      success
    rescue StandardError => e # кривой реквизит или override-выражение → отклонить операцию, а не уронить воркер
      failure(:unprocessable_entity, 'requisite_invalid', message: e.message)
    end

    def create_request(operation, request_method = 'create')
      return fetch_status(operation) if STATUS_METHODS.include?(request_method)

<% if view.requisites? -%>
      requisite_type = requisite_type_for(operation, request_method)
      return failure(:unprocessable_entity, 'requisite_missing') unless requisite_type

      payload = build_payout_payload(operation, requisite_type)
<% else -%>
      payload = build_payout_payload(operation)
<% end -%>
<% if view.idempotency? -%>
      response = client.post(<%= view.paths.url(:create) %>, <%= view.body_kw %>: payload,
                             <%= ' ' * (view.paths.url(:create).size + 2) %>headers: auth_headers.merge(idempotency_headers(operation)))
<% else -%>
      response = client.post(<%= view.paths.url(:create) %>, <%= view.body_kw %>: payload, headers: auth_headers)
<% end -%>
      parse_create_response(operation, response)
<%= partial('_rescues.erb') -%>
    end

<% if view.op(:status) -%>
    def fetch_status(operation)
<% if view.op(:status).status_request_field -%>
      body = { '<%= view.op(:status).status_request_field %>' => operation.provider_operation_key }
      response = client.post(<%= view.paths.url(:status) %>, json: body, headers: auth_headers)
<% else -%>
      response = client.get(<%= view.paths.url(:status) %>, headers: auth_headers)
<% end -%>
      return failure(http_symbol(response.status), "provider.#{error_code_for(response)}") unless response.status == <%= view.op(:status).success_statuses.first %>

      apply_status(operation, <%= view.paths.status_body %>, strict: true)
<%= partial('_rescues.erb') -%>
    end
<% else -%>
    def fetch_status(_operation)
      failure(:not_implemented, 'status_endpoint_missing') # TODO(forge): no status endpoint in the spec
    end
<% end -%>

<% if view.webhook -%>
    def process_callback(payload, raw_body: nil, headers: {})
<% if view.signature? -%>
      verify_signature!(raw_body || JSON.generate(payload), headers)
<% end -%>
<% if plan.event_map.empty? -%>
      internal_status = STATUS_MAP[<%= view.paths.payload(view.webhook[:status_field] || ['status']) %>]
      return failure(:unprocessable_entity, 'unknown_provider_status', status: <%= view.paths.payload(view.webhook[:status_field] || ['status']) %>) unless internal_status
<% else -%>
      internal_status = EVENT_MAP[payload['<%= view.webhook[:event_field] %>']]<%= " || STATUS_MAP[#{view.paths.payload(view.webhook[:status_field])}]" if view.webhook[:status_field] %>
      return failure(:unprocessable_entity, 'unknown_event', event: payload['<%= view.webhook[:event_field] %>']) unless internal_status
<% end -%>

      case internal_status
      when 'approved' then approve_operation(<%= view.paths.payload(view.webhook[:id_field] || ['id']) %>)
      when 'rejected' then reject_operation(<%= view.paths.payload(view.webhook[:id_field] || ['id']) %><%= view.paths.callback_error_code %>)
      else mark_in_progress(<%= view.paths.payload(view.webhook[:id_field] || ['id']) %>)
      end
<% if view.signature? -%>
    rescue Provider::SignatureError
      failure(:unauthorized, 'invalid_signature')
<% end -%>
<% if view.timestamp_unsupported? -%>
    rescue NotImplementedError => e # схема подписи не сгенерирована (UNSUPPORTED в report.txt): callback отклоняем, не падаем
      failure(:not_implemented, 'signature_unsupported', message: e.message)
<% end -%>
    end
<% else -%>
    def process_callback(_payload, raw_body: nil, headers: {})
      failure(:not_implemented, 'callbacks_not_supported') # TODO(forge): no webhook in the spec
    end
<% end -%>
<% if view.op(:cancel) || view.op(:balance) -%>

    # Endpoints outside the BaseService contract (<%= [view.op(:cancel) && 'cancel', view.op(:balance) && 'balance'].compact.join(', ') %>)
    # are generated as optional helpers in <%= plan.provider[:name] %>_extras.rb (<%= plan.provider[:class_name].delete_suffix('Service') %>Extras < <%= plan.provider[:class_name] %>).
<% end -%>

    private

<%= partial('_auth_headers.erb') -%>
<% if view.idempotency? -%>

    def idempotency_headers(operation)
      { '<%= view.op(:create).headers.first.provider_field %>' => <%= view.op(:create).headers.first.source_expr %> }
    end
<% end -%>
<% if view.requisites? -%>

    def requisite_type_for(operation, request_method)
      return request_method if REQUISITE_TYPES.include?(request_method)

      (operation.payout_requisite.keys & REQUISITE_TYPES).first<% if plan.requisite_types.include?('card') %> || ('card' if operation.payout_requisite.key?('card_number'))<% end %>
    end

    # Реквизиты на платформе: вложенные (payout_requisite['sbp'] = {…}) или плоские (payout_requisite['card_number']).
    def requisite_for(operation, requisite_type)
      operation.payout_requisite.fetch(requisite_type) { operation.payout_requisite }
    end
<% end -%>

    def build_payout_payload(operation<%= ', requisite_type' if view.requisites? %>)
      deep_compact(
        {
<% view.payload_lines.each do |line| -%>
          <%= line %>
<% end -%>
        }
      )
    end

    # Убирает nil, пустые Hash/Array и объекты из одних nil (поля без источника — TODO выше).
    def deep_compact(value)
      case value
      when Hash then value.transform_values { |v| deep_compact(v) }.reject { |_k, v| v.nil? || v == {} || v == [] }
      when Array then value.map { |v| deep_compact(v) }.compact
      else value
      end
    end
<% if view.container? -%>

    def build_recipient(operation, requisite_type)
<% if view.variants? -%>
<% view.recipient_lines.each do |line| -%>
      <%= line %>
<% end -%>
<% else -%>
      requisite = requisite_for(operation, requisite_type)
      {
<% view.recipient_lines.each do |line| -%>
        <%= line %>
<% end -%>
      }
<% end -%>
    end
<% end -%>

    def parse_create_response(operation, response)
      unless SUCCESS_STATUSES.include?(response.status)
        return failure(http_symbol(response.status), "provider.#{error_code_for(response)}",
                       provider_code: <%= view.paths.create_error_code %>, message: <%= view.paths.create_error_message %>)
      end

      operations.update(operation.id, provider_operation_key: <%= view.paths.body(view.op(:create).response_id_path) %>)
      apply_status(operation, <%= view.paths.body(view.op(:create).response_status_path) %>)
    end

    # Успешный ответ без распознаваемого статуса (нет поля или значение вне STATUS_MAP) → in_progress:
    # операция создана, итог придёт через fetch_status / webhook. unknown_provider_status — только для fetch_status.
    def apply_status(operation, provider_status, strict: false)
      status = STATUS_MAP[provider_status.to_s]
      if status.nil?
        return failure(:unprocessable_entity, 'unknown_provider_status', provider_status: provider_status) if strict

        status = 'in_progress'
      end

      transition(operation, status, provider_status: provider_status)
    end

    def error_code_for(response)
      ERROR_MAP.fetch(response.status) { <%= view.paths.create_error_code %> || 'unknown_error' }
    end
<% if view.signature? -%>

<%= partial('_verify_signature.erb') -%>
<% end -%>
<% if view.minor? -%>

    def to_minor_units(amount)
      (amount * AMOUNT_MULTIPLIER).round.to_i
    end
<% end -%>
  end
end
