#!/usr/bin/env ruby
# frozen_string_literal: true

# Обёртка с флагами из ТЗ: --spec FILE --provider NAME [--lang ruby] → bin/forge generate --out ./output/<provider>
require 'optparse'
require_relative '../lib/forge/plan/naming'

opts = { lang: 'ruby' }
begin
  OptionParser.new do |o|
    o.banner = 'usage: bin/integrate --spec FILE --provider NAME [--lang ruby]'
    o.on('--spec FILE') { |v| opts[:spec] = v }
    o.on('--provider NAME') { |v| opts[:provider] = v }
    o.on('--lang LANG') { |v| opts[:lang] = v }
  end.parse!
rescue OptionParser::ParseError => e
  abort "error: #{e.message}\nusage: bin/integrate --spec FILE --provider NAME [--lang ruby]"
end

unless opts[:lang] == 'ruby'
  warn "error: only ruby is supported (got --lang #{opts[:lang]})"
  exit 1
end
abort 'error: --spec and --provider are required' unless opts[:spec] && opts[:provider]

forge = File.expand_path('forge', __dir__)
out = File.join('./output', Forge::Plan::Naming.from_provider(opts[:provider])[:name])
exec(forge, 'generate', '--spec', opts[:spec], '--provider', opts[:provider], '--out', out, '--force')
